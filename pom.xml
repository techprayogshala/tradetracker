<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.0</version>
        <relativePath/>
    </parent>

    <groupId>com.tradetracker</groupId>
    <artifactId>tradetracker-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>TradeTracker Parent</name>
    <description>Open-source portfolio tracker — Sharesight alternative</description>

    <modules>
        <module>tradetracker-common</module>
        <module>tradetracker-security</module>
        <module>tradetracker-portfolio</module>
        <module>tradetracker-calculation</module>
        <module>tradetracker-tax</module>
        <module>tradetracker-broker</module>
        <module>tradetracker-marketdata</module>
        <module>tradetracker-notification</module>
        <module>tradetracker-scheduler</module>
        <module>tradetracker-document</module>
        <module>tradetracker-api</module>
        <module>tradetracker-app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <spring-cloud.version>2023.0.1</spring-cloud.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <springdoc.version>2.3.0</springdoc.version>
        <pdfbox.version>3.0.1</pdfbox.version>
        <tika.version>2.9.1</tika.version>
        <jasperreports.version>6.21.0</jasperreports.version>
        <flyway.version>10.12.0</flyway.version>
        <testcontainers.version>1.19.8</testcontainers.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules -->
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-security</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-portfolio</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-calculation</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-tax</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-broker</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-marketdata</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-scheduler</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-document</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.tradetracker</groupId>
                <artifactId>tradetracker-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- PDF -->
            <dependency>
                <groupId>org.apache.pdfbox</groupId>
                <artifactId>pdfbox</artifactId>
                <version>${pdfbox.version}</version>
            </dependency>
            <dependency>
                <groupId>org.apache.tika</groupId>
                <artifactId>tika-core</artifactId>
                <version>${tika.version}</version>
            </dependency>

            <!-- Reports -->
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>

            <!-- MapStruct -->
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>

            <!-- Spring Data JPA -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-starter-data-jpa</artifactId>
                <version>3.3.0</version>
            </dependency>

            <!-- OpenAPI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Testcontainers -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>${testcontainers.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
