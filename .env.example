# ================================================================
# TradeTracker — Environment Variables
# cp .env.example .env  then fill in your values
# .env is gitignored — never commit secrets
# ================================================================

# PostgreSQL
DB_USER=tradetracker
DB_PASSWORD=tradetracker_dev

# Redis
REDIS_PASSWORD=redis_dev

# MinIO / S3 (same vars work for both)
AWS_ACCESS_KEY_ID=tradetracker
AWS_SECRET_ACCESS_KEY=minio_dev

# RabbitMQ
RABBITMQ_USER=tradetracker
RABBITMQ_PASSWORD=rabbit_dev

# Keycloak
KEYCLOAK_ADMIN_PASSWORD=admin

# Grafana
GRAFANA_PASSWORD=admin

# Market data (free tier keys)
ALPHA_VANTAGE_API_KEY=demo
OPEN_EXCHANGE_RATES_APP_ID=

# Broker integrations (Phase 2 — leave blank for Phase 1)
COMMSEC_CLIENT_ID=
COMMSEC_CLIENT_SECRET=
IBKR_CLIENT_ID=
IBKR_CLIENT_SECRET=
