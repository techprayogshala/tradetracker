<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.tradetracker</groupId>
        <artifactId>tradetracker-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>tradetracker-app</artifactId>
    <description>Spring Boot entry point — wires all modules into a single deployable JAR</description>

    <dependencies>
        <!-- All modules wired here -->
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-portfolio</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-calculation</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-tax</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-broker</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-marketdata</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-notification</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-scheduler</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-document</artifactId>
        </dependency>
        <dependency>
            <groupId>com.tradetracker</groupId>
            <artifactId>tradetracker-security</artifactId>
        </dependency>

        <!-- Runtime: database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Observability -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.tradetracker.app.TradeTrackerApplication</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>3.4.0</version>
            </plugin>
            <plugin>
                <groupId>org.flywaydb</groupId>
                <artifactId>flyway-maven-plugin</artifactId>
                <configuration>
                    <locations>
                        <location>classpath:db/migration/portfolio</location>
                        <location>classpath:db/migration/calculation</location>
                        <location>classpath:db/migration/tax</location>
                        <location>classpath:db/migration/broker</location>
                        <location>classpath:db/migration/marketdata</location>
                        <location>classpath:db/migration/notification</location>
                        <location>classpath:db/migration/scheduler</location>
                        <location>classpath:db/migration/document</location>
                        <location>classpath:db/migration/security</location>
                    </locations>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
