{
  "realm": "tradetracker",
  "enabled": true,
  "displayName": "TradeTracker",
  "sslRequired": "none",
  "registrationAllowed": true,
  "loginWithEmailAllowed": true,
  "resetPasswordAllowed": true,
  "bruteForceProtected": true,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "tradetracker-frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:3002/*", "http://localhost/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3002", "http://localhost"],
      "protocol": "openid-connect",
      "attributes": { "pkce.code.challenge.method": "S256" }
    },
    {
      "clientId": "tradetracker-backend",
      "enabled": true,
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "secret": "change-me-in-production",
      "protocol": "openid-connect"
    }
  ],
  "roles": {
    "realm": [
      { "name": "user",  "description": "Standard portfolio user" },
      { "name": "admin", "description": "Platform administrator" }
    ]
  },
  "defaultRoles": ["user"],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "email": "demo@tradetracker.local",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "Demo123!@#",
          "temporary": false
        }
      ],
      "realmRoles": ["user"]
    }
  ],
  "passwordPolicy": "length(8) and digits(1)"
}
